{
  "name": "serverless-github-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless serverless GitHub bulk repository manager (Vercel + Hono)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i src/styles.css -o public/assets/styles.css --minify",
